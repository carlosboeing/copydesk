#!/usr/bin/env python3
"""Run the Plain English linter over Markdown paths or standard input."""

from __future__ import annotations

import sys
from pathlib import Path


BUNDLE_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(BUNDLE_ROOT / "lib"))

import linter  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    paths = list(sys.argv[1:] if argv is None else argv)
    if not paths:
        print("usage: plain-english <file.md> [...] | -", file=sys.stderr)
        return 64

    failed = False
    for source in paths:
        if source == "-":
            label, text = "<stdin>", sys.stdin.read()
        else:
            label = source
            try:
                text = Path(source).read_text(encoding="utf-8")
            except OSError as error:
                print(f"{source}: {error}", file=sys.stderr)
                failed = True
                continue

        findings = linter.lint(text, path=source)
        if findings:
            print(f"{label}:")
            for finding in findings:
                print(finding.render())
            failed = failed or linter.has_blocking_findings(findings)

    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
