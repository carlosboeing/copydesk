#!/usr/bin/env python3
"""Run the CopyDesk linter over Markdown paths or standard input."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys
import time


BUNDLE_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(BUNDLE_ROOT / "lib"))

import channels  # noqa: E402
import config_writer  # noqa: E402
import linter  # noqa: E402
import wizard  # noqa: E402


SETTABLE_KEYS = {"channels.chat.verbosity": ("low", "medium", "high")}


def _rebuild_static_instructions() -> int:
    """Re-render the static files after a config change. Never fails the set."""
    generator = BUNDLE_ROOT / "scripts" / "generate-instructions.py"
    if not generator.is_file():
        print("note: run `copydesk setup --repair` to rebuild the installed instructions")
        return 0
    result = subprocess.run([sys.executable, str(generator)], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"note: rebuild failed ({result.stderr.strip()[:80]}); "
              "run `copydesk setup --repair`")
    return 0


def _handle_set(args: list[str]) -> int:
    if len(args) != 1 or "=" not in args[0]:
        print("usage: copydesk set channels.chat.verbosity=<low|medium|high>", file=sys.stderr)
        return 64
    key, _, value = args[0].partition("=")
    allowed = SETTABLE_KEYS.get(key)
    if allowed is None:
        print(f"error: '{key}' is not settable. Settable: {', '.join(sorted(SETTABLE_KEYS))}", file=sys.stderr)
        return 64
    if value not in allowed:
        print(f"error: '{value}' is not one of {', '.join(allowed)}", file=sys.stderr)
        return 64

    target = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    target = target / "copydesk" / "config.json"
    return config_writer.set_value(target, key, value) or _rebuild_static_instructions()


def _handle_stats(args: list[str]) -> int:
    since = None
    as_json = False
    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg == "--json":
            as_json = True
            idx += 1
        elif arg == "--since":
            if idx + 1 >= len(args):
                print("error: --since requires a value", file=sys.stderr)
                return 64
            since = args[idx + 1]
            idx += 2
        else:
            print(f"error: unknown stats option '{arg}'", file=sys.stderr)
            return 64

    try:
        events = linter.read_events(since=since)
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 64
    summary = linter.summarize_events(events)

    if as_json:
        print(json.dumps(summary, indent=2))
    else:
        print(linter.format_stats_terminal(summary))
    return 0


def _handle_report(args: list[str]) -> int:
    since = None
    out_path = None
    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg == "--out":
            if idx + 1 >= len(args):
                print("error: --out requires a value", file=sys.stderr)
                return 64
            out_path = Path(args[idx + 1])
            idx += 2
        elif arg == "--since":
            if idx + 1 >= len(args):
                print("error: --since requires a value", file=sys.stderr)
                return 64
            since = args[idx + 1]
            idx += 2
        else:
            print(f"error: unknown report option '{arg}'", file=sys.stderr)
            return 64

    try:
        events = linter.read_events(since=since)
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 64
    summary = linter.summarize_events(events)
    content = linter.format_report_markdown(summary)

    if out_path is None:
        report_date = summary["end_date"]
        telemetry_dir = BUNDLE_ROOT / "eval" / "telemetry"
        telemetry_dir.mkdir(parents=True, exist_ok=True)
        out_path = telemetry_dir / f"{report_date}-copydesk-telemetry-report.md"
    else:
        out_path.parent.mkdir(parents=True, exist_ok=True)

    out_path.write_text(content + "\n", encoding="utf-8")
    print(f"Report written to {out_path}")
    return 0


# Reserved for later releases. Naming them now stops a 0.1.0 flag from claiming
# a word a subcommand will need, and gives a clear message instead of linting a
# file that does not exist.
RESERVED_SUBCOMMANDS = ("install", "learn", "fix", "import")

SUBCOMMANDS = ("check", "doctor", "stats", "report", "set", "setup", "uninstall")

USAGE = """usage: copydesk setup [--defaults] [--yes] [--dry-run] [--repair]
       copydesk uninstall [--yes] [--dry-run] [--purge]
       copydesk check <file.md> [...] | -
       copydesk set <key>=<value>
       copydesk doctor
       copydesk stats [--since <window>] [--json]
       copydesk report [--since <window>] [--out <path>]
       copydesk --version

CopyDesk is a prose gate for AI agents. Run `copydesk doctor` to see which
config files and presets it resolves."""


def _version() -> str:
    try:
        return (BUNDLE_ROOT / "VERSION").read_text(encoding="utf-8").strip()
    except OSError:
        return "unknown"


def _handle_doctor(args: list[str]) -> int:
    """Report what CopyDesk resolves. Never mutates anything."""
    if args:
        print(f"error: doctor takes no options, got '{args[0]}'", file=sys.stderr)
        return 64

    print(f"CopyDesk {_version()}")
    print()

    print("Preset")
    preset_path = linter._preset_path()
    print(f"  path      {preset_path}{'' if preset_path.is_file() else '   MISSING'}")
    if preset_path.is_file():
        preset = linter.load_preset(preset_path)
        tokens = sum(len(b["tokens"]) for b in preset["patterns"])
        print(f"  id        {preset['id']}")
        print(f"  patterns  {len(preset['patterns'])} blocks, {tokens} tokens")
        print(f"  rules     {len(preset.get('rules', {}))} metric and structural")
    print()

    print("Config")
    discovery = linter.config.describe_discovery(Path.cwd()) if linter.config else {"user": None, "project": None, "errors": []}
    print(f"  user      {discovery['user'] or 'none'}")
    print(f"  project   {discovery['project'] or 'none'}")
    for error in discovery["errors"]:
        print(f"  error     {error}")
    print()

    print("State")
    state_dir = linter._state_directory()
    events = state_dir / "events.jsonl"
    print(f"  directory {state_dir}{'' if state_dir.is_dir() else '   (not created yet)'}")
    print(f"  events    {events if events.is_file() else 'none recorded yet'}")
    print(f"  logging   {'off (COPYDESK_LOG=0)' if os.environ.get('COPYDESK_LOG') == '0' else 'on'}")
    print()

    print("Hooks")
    hook_dir = Path.home() / ".claude" / "hooks" / "copydesk"
    for name in ("gate.sh", "reminder.sh", "linter.py"):
        installed = hook_dir / name
        print(f"  {name:12} {'installed' if installed.is_file() else 'not installed'}   {installed}")
    hook_preset = hook_dir / "rules" / "plain-english.json"
    print(f"  {'rules/':12} {'installed' if hook_preset.is_file() else 'not installed'}   {hook_preset}")
    print()

    print("Harness registration")
    settings = Path.home() / ".claude" / "settings.json"
    if settings.is_file():
        try:
            text = settings.read_text(encoding="utf-8")
            registered = "copydesk" in text
            print(f"  Claude Code  {'registered' if registered else 'settings.json found, no CopyDesk hook'}")
        except OSError as error:
            print(f"  Claude Code  settings.json unreadable ({error.strerror})")
    else:
        print("  Claude Code  no settings.json found")

    return 0


def _handle_check(args: list[str]) -> int:
    if not args:
        print("error: check needs at least one path, or - for standard input", file=sys.stderr)
        return 64

    failed = False
    for source in args:
        if source.startswith("-") and source != "-":
            print(f"error: unknown check option '{source}'", file=sys.stderr)
            return 64
        if source == "-":
            label, text = "<stdin>", sys.stdin.read()
            abs_path = "<stdin>"
        else:
            label = source
            try:
                p = Path(source)
                text = p.read_text(encoding="utf-8")
                abs_path = str(p.resolve())
            except OSError as error:
                print(f"{source}: {error}", file=sys.stderr)
                failed = True
                continue

            resolved, _ = linter.effective_preset(abs_path)
            decision = channels.decide(abs_path, resolved)
            if decision.action == "ignore":
                print(f"{source}: not checked (paths.ignore)")
                continue

        t_start = time.time()
        findings = linter.lint(text, path=source)
        t_end = time.time()
        duration_ms = round((t_end - t_start) * 1000, 1)

        doc_bytes = len(text.encode("utf-8"))
        doc_words = len(text.split())
        body_sentences = len(linter._sentence_records(linter.exclude_markdown(text)))
        is_blocked = linter.has_blocking_findings(findings)

        # A CLI run lints a whole document with no edit region, so it carries no
        # origin rollup. The summariser reads origins from gate events only.
        rollups = linter._finding_rollups(findings)

        linter._record_event({
            "ts": round(time.time(), 1),
            "event": "lint",
            "surface": "cli",
            "tool": None,
            "path": abs_path,
            "decision": "block" if is_blocked else "pass",
            "streak": 0,
            "duration_ms": duration_ms,
            "bytes": doc_bytes,
            "payload_bytes": doc_bytes,
            "payload_words": doc_words,
            "sentences": body_sentences,
            "findings_total": len(findings),
            "rule_totals": rollups["rule_totals"],
            "blocking_rule_totals": rollups["blocking_rule_totals"],
            "findings": linter._serialize_findings(findings),
        })

        if findings:
            print(f"{label}:")
            for finding in findings:
                print(finding.render())
            failed = failed or is_blocked

    return 1 if failed else 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        print(USAGE, file=sys.stderr)
        return 64

    command = args[0]

    if command in ("--version", "-V"):
        print(_version())
        return 0
    if command in ("--help", "-h", "help"):
        print(USAGE)
        return 0

    if command in RESERVED_SUBCOMMANDS:
        print(f"error: '{command}' is reserved for a later release and does nothing yet", file=sys.stderr)
        return 64

    if command in ("setup", "init"):
        return wizard.run_setup(args[1:])
    if command == "uninstall":
        return wizard.run_uninstall(args[1:])
    if command == "stats":
        return _handle_stats(args[1:])
    if command == "report":
        return _handle_report(args[1:])
    if command == "doctor":
        return _handle_doctor(args[1:])
    if command == "set":
        return _handle_set(args[1:])
    if command == "check":
        return _handle_check(args[1:])

    # A bare path list still lints, which is what every existing caller does.
    return _handle_check(args)


if __name__ == "__main__":
    raise SystemExit(main())
