# The private working-memory sidecar. carlosboeing/copydesk-workbench is
# cloned here as an independent git repository, nested rather than
# submoduled, so this public repository must never track it.
.workbench/

# Python bytecode
__pycache__/
*.pyc

# Worktrees
.worktrees/

# Hooks `copydesk setup` installs into this repository. It writes to
# `core.hooksPath`, so the directory name is whatever the contributor has
# configured; `my-hooks` and `.githooks` are the common ones. The tracked
# sources live in `git-hooks/` and are unaffected.
my-hooks/
.githooks/
