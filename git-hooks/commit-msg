#!/usr/bin/env bash
# CopyDesk commits gate. git writes COMMIT_EDITMSG itself, mid-command, where
# no harness hook stands, so the check mounts on git's own message hook.
#
# git commit --no-verify skips it. That is git's contract for every message
# hook, documented rather than fought.

set -u

COPYDESK="${COPYDESK_BIN:-copydesk}"

if ! command -v "$COPYDESK" >/dev/null 2>&1 && [[ ! -x "$COPYDESK" ]]; then
  exit 0   # fails open: no CopyDesk is not a reason to refuse a commit
fi

"$COPYDESK" check --commit-msg "$1"
status=$?

case "$status" in
  0)  exit 0 ;;
  1)  exit 1 ;;                                  # the only refusal
  *)  echo "copydesk: check failed (exit $status); commit allowed" >&2
      exit 0 ;;                                  # fails open
esac
