#!/usr/bin/env bash
# Git pre-commit hook for CopyDesk.
# Runs the CopyDesk test suite before committing, so a rule or linter
# regression cannot reach a commit.
#
# No path guard. An earlier version guarded on a bundle path and exited 0
# in silence once that path moved, which is the failure mode this hook
# exists to prevent.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

python3 -m unittest discover tests/
