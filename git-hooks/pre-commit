#!/usr/bin/env bash
# Git pre-commit hook for claude-code-resources.
# Runs Plain English tests before committing to prevent regressions in rules or linter checks.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ -f "tools/plain-english/tests/test_checks.py" ] && [ -f "tools/plain-english/tests/test_rules_sync.py" ]; then
    python3 -m unittest discover tools/plain-english/tests/
fi
