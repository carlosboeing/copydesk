{
  "version": 1,
  "id": "general",
  "title": "General",
  "description": "Plain writing with nothing assumed. Every term is glossed.",
  "extends": "plain",
  "patterns": [],
  "rules": {
    "unglossed-term": {
      "severity": "error"
    },
    "sentence-length": {
      "severity": "error",
      "max": 20,
      "hardMax": 30
    },
    "avg-sentence-length": {
      "severity": "warn",
      "min": 10,
      "max": 16
    }
  }
}
